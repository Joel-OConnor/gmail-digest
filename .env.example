# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#   cp .env.example .env
# Then run: npm run setup

# ---------------------------------------------------------------- AWS --------
# The digest runs as a Lambda in your own AWS account. You need credentials
# configured for the AWS CLI (`aws configure`) with permission to create IAM
# roles, a Lambda, an EventBridge schedule, SSM parameters and a log group.
AWS_REGION=us-east-1
# Set only if you use a named profile. Any AWS_PROFILE, even "default", makes
# the SDK ignore credentials exported as AWS_ACCESS_KEY_ID and friends.
# AWS_PROFILE=my-profile

# Names this install uses. Change them only if you run more than one copy.
FUNCTION_NAME=gmail-digest
SSM_PREFIX=/gmail-digest

# ------------------------------------------------------------ Digest ---------
# Where the digest is sent. Usually your own address; it can be any inbox you
# want the summary delivered to.
DIGEST_RECIPIENT=you@example.com

# IANA timezone. npm run bootstrap uses it for the schedule and npm run deploy
# sends it for the digest timestamps, so after changing it run both.
TIMEZONE=America/New_York

# When the digest runs, as an EventBridge Scheduler expression in TIMEZONE.
# Read by npm run bootstrap. Left unset, a first run uses the default below and
# re-runs keep whatever schedule is already there.
# CRON=cron(0 10,16 * * ? *)

# Days CloudWatch keeps the function's logs. Read by npm run bootstrap.
# LOG_RETENTION_DAYS=14

# Claude model used for classification. claude-haiku-4-5 is roughly 3x cheaper
# and noticeably blunter. See README for cost figures.
MODEL=claude-sonnet-4-6

# Lowest tier that makes it into the digest: high | medium | low.
# "high" means only what needs you today. "low" shows everything.
MIN_IMPORTANCE=medium

# inbox   = only mail still in the inbox when the run fires.
# arrived = everything that arrived in the window, even if you already archived
#           it. Choose this if you triage on your phone during the day.
SCAN_SCOPE=inbox

# Safety cap on messages classified per mailbox per run. Mail beyond it is
# skipped for good, not carried over, and the digest says how much was skipped.
MAX_EMAILS=100

# Comma-separated list of mailboxes to scan. The names are yours to choose;
# each needs its own authorisation:
#
#   ACCOUNTS=personal            npm run add-account personal
#   ACCOUNTS=personal,work       ...then: npm run add-account work
#
# With more than one, each email in the digest is tagged with the mailbox it
# arrived in, and its link opens that mailbox.
ACCOUNTS=personal

# Optional. Left unset, no temperature is sent, because newer models reject one
# outright. Set it only if your model accepts it and you want deterministic runs.
# TEMPERATURE=0

# ------------------------------------------------------- Credentials ---------
# There are none in this file, on purpose. `npm run setup` prompts for your
# Anthropic key and Google OAuth client with the terminal echo off and passes
# them straight to SSM Parameter Store as encrypted SecureStrings, so they are
# never written to disk. `npm run add-account <name>` stores each Gmail refresh
# token the same way, straight from Google's sign-in in your browser.
#
# For non-interactive use, npm run setup also reads ANTHROPIC_API_KEY,
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from the environment. Prompting is
# still the better path, since exported values tend to end up in shell history.
